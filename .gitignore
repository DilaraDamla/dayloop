# Claude Code local settings (may contain machine-specific permissions)
.claude/

# Secrets / local env
.env
.env.*
*.local

# Cloudflare Worker local secrets (see worker/.dev.vars.example)
worker/.dev.vars
worker/.dev.vars.*
!worker/.dev.vars.example
worker/.wrangler/

# Sprint 1 security hardening: common credential/key file patterns, in case
# any future backend/service-account work introduces one of these — kept
# broad and applied repo-wide (not just under worker/) on purpose.
*.pem
*.key
*.p12
*.pfx
credentials.json
service-account*.json
*-service-account.json
gcloud-service-key.json
firebase-adminsdk*.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Future tooling (no build step exists yet, but keep this ready)
node_modules/
dist/
