rules_version = '2';

// DayLoop Firestore security rules.
//
// Data model in use by index.html (verified against the actual read/write
// call sites, not assumed): saved plans live at users/{userId}/plans/{planId},
// wish-listed places live at users/{userId}/wishlist/{placeKey}.
//   - write: fbDb.collection('users').doc(fbUser.uid).collection('plans').doc(String(entry.id)).set(entry)
//   - read:  fbDb.collection('users').doc(fbUser.uid).collection('plans').orderBy('id','desc').limit(20).get()
//   - delete: fbDb.collection('users').doc(fbUser.uid).collection('plans').doc(String(id)).delete()
//   - write: fbDb.collection('users').doc(fbUser.uid).collection('wishlist').doc(key).set(entry)
//   - read:  fbDb.collection('users').doc(fbUser.uid).collection('wishlist').orderBy('addedAt','desc').limit(100).get()
//   - delete: fbDb.collection('users').doc(fbUser.uid).collection('wishlist').doc(key).delete()
// In all cases {userId} is always the caller's own Firebase Auth UID
// (fbUser.uid comes from onAuthStateChanged, never from user-editable input).
//
// Shared/collaborative plans (invite-friends feature) live at
// sharedPlans/{shareId}, with each participant as their own document at
// sharedPlans/{shareId}/participants/{uid} — {shareId} is a Firestore
// client-generated auto-id (fbDb.collection('sharedPlans').doc().id), never
// user-supplied, and doubles as the unguessable link token shared out of
// band (a URL query param). {uid} under participants is always the caller's
// own Firebase Auth uid, exactly like {userId} above.
//   - create: fbDb.collection('sharedPlans').doc(shareId).set(sharedPlanDoc)          [owner only]
//   - update/delete: fbDb.collection('sharedPlans').doc(shareId).update(...)/.delete() [owner only]
//   - read:  fbDb.collection('sharedPlans').doc(shareId).get()                        [any signed-in user with the link]
//   - create: fbDb.collection('sharedPlans').doc(shareId).collection('participants').doc(uid).set(entry)  [self only — this is "join"]
//   - delete: fbDb.collection('sharedPlans').doc(shareId).collection('participants').doc(uid).delete()    [self only — this is "leave"]
//   - read:  fbDb.collection('sharedPlans').doc(shareId).collection('participants').get()
//
// NOT deployed by this change — see docs/security/manual-owner-actions.md for
// the manual deploy step required before these rules take effect.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Sprint 1 hardening: beyond per-user isolation (the load-bearing check),
    // reject writes whose shape doesn't look like what index.html actually
    // sends — an unexpected top-level field, a wrong type, or an absurdly
    // large list. Deliberately loose on VALUES (vibe/group/budget are not
    // pinned to a fixed enum here — new vibes/tiers have been added before
    // and will be again; a rules-level enum would silently break legitimate
    // writes the next time that happens). This is a defense against a signed-
    // in user's own client writing malformed/oversized data into their own
    // document, not a privacy boundary — isOwner() above is what prevents any
    // cross-user access, and stays true regardless of these checks.
    function isValidPlan(data) {
      return data.keys().hasOnly(['id','dateStr','startMin','endMin','vibe','group','budget','travelMode','center','weather','stops','totalWalkKm','totalWalkMin','routeGeometry'])
        && data.id is number
        && data.dateStr is string && data.dateStr.size() <= 20
        && data.startMin is number && data.startMin >= 0 && data.startMin <= 1440
        && data.endMin is number && data.endMin >= 0 && data.endMin <= 1440
        && data.vibe is string && data.vibe.size() <= 50
        && data.group is string && data.group.size() <= 50
        && data.budget is number
        // Not pinned to ['foot','car'] for the same reason vibe/group aren't
        // pinned to an enum above — a future mode shouldn't need a rules
        // change to work, just a real string identifying it.
        && data.travelMode is string && data.travelMode.size() <= 20
        && data.center is map
        && data.weather is map
        && data.stops is list && data.stops.size() <= 20
        && data.totalWalkKm is number
        && data.totalWalkMin is number
        && (data.routeGeometry == null || (data.routeGeometry is list && data.routeGeometry.size() <= 5000));
    }

    function isValidWishlistItem(data) {
      return data.keys().hasOnly(['key','addedAt','name','category','city','address'])
        && data.key is string && data.key.size() <= 100
        && data.addedAt is number
        && data.name is string && data.name.size() <= 300
        && data.category is string && data.category.size() <= 50
        && data.city is string && data.city.size() <= 300
        && (data.address == null || (data.address is string && data.address.size() <= 300));
    }

    // Same field set/shape as isValidPlan above (this IS the plan the owner
    // just generated, unmodified — see buildSharedPlanDoc in index.html)
    // plus three collaboration fields: who owns it, their display name for
    // the "who's coming" list, and when it was created.
    function isValidSharedPlan(data) {
      return data.keys().hasOnly(['ownerId','ownerName','createdAt','dateStr','startMin','endMin','vibe','group','budget','travelMode','center','weather','stops','totalWalkKm','totalWalkMin','routeGeometry'])
        && data.ownerId is string
        && data.ownerName is string && data.ownerName.size() <= 100
        && data.createdAt is number
        && data.dateStr is string && data.dateStr.size() <= 20
        && data.startMin is number && data.startMin >= 0 && data.startMin <= 1440
        && data.endMin is number && data.endMin >= 0 && data.endMin <= 1440
        && data.vibe is string && data.vibe.size() <= 50
        && data.group is string && data.group.size() <= 50
        && data.budget is number
        && data.travelMode is string && data.travelMode.size() <= 20
        && data.center is map
        && data.weather is map
        && data.stops is list && data.stops.size() <= 20
        && data.totalWalkKm is number
        && data.totalWalkMin is number
        && (data.routeGeometry == null || (data.routeGeometry is list && data.routeGeometry.size() <= 5000));
    }

    function isValidParticipant(data) {
      return data.keys().hasOnly(['uid','displayName','joinedAt'])
        && data.uid is string
        && data.displayName is string && data.displayName.size() <= 100
        && data.joinedAt is number;
    }

    // A user's own saved plans. Only the signed-in user whose auth UID
    // matches {userId} may read or write documents under their own path;
    // no other signed-in user, and no unauthenticated caller, can reach it —
    // true for read/delete AND for create/update, independent of the shape
    // validation below.
    match /users/{userId}/plans/{planId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidPlan(request.resource.data);
    }

    // A user's own wish-listed places. Same per-user isolation as plans above.
    match /users/{userId}/wishlist/{placeKey} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidWishlistItem(request.resource.data);
    }

    // A plan shared for a group to coordinate around (invite-friends
    // feature). Deliberately readable by ANY signed-in user, not only
    // existing participants: {shareId} is an unguessable Firestore auto-id,
    // and opening the link to preview the plan is how someone decides
    // whether to join in the first place — the same "anyone with the link"
    // model most link-sharing products use. Requiring sign-in (rather than
    // allowing fully anonymous reads) still keeps it out of reach of an
    // unauthenticated scraper/bot and matches this feature's chosen
    // "must have a DayLoop account to join" participation model.
    match /sharedPlans/{shareId} {
      allow read: if request.auth != null;
      // Only the plan's own owner (fixed permanently at creation — never
      // reassignable, never taken from anything but the write itself) may
      // create, update, or delete the shared plan document. Every other
      // participant joins via their own doc in the subcollection below;
      // none of them ever write this document.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && isValidSharedPlan(request.resource.data);
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // Each participant (the owner included — added the same way at
      // creation time) is their own document, keyed by their own uid. This
      // is what makes "anyone with the link can join, and can bring in
      // their own friends" safe: a participant can only ever create or
      // delete THEIR OWN doc, never anyone else's, so joining/leaving can
      // never touch another participant's membership. Deliberately
      // immutable (update denied) — changing a display name means leaving
      // and rejoining, which keeps this rule simple and hard to get wrong.
      match /participants/{participantId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == participantId
          && request.resource.data.uid == participantId
          && isValidParticipant(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == participantId;
        allow update: if false;
      }
    }

    // Deny everything else by default. Firestore already denies any request
    // that doesn't match an explicit `allow` rule, but this makes that
    // default explicit for every other path — including any future
    // collection (e.g. a Taste Profile) added under users/{userId}/ before an
    // explicit, equally-scoped rule is written for it.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
